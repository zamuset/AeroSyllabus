{
  "name": "aerosyllabus",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-constants": "~57.0.21",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "gh-pages": "^6.3.0",
    "serve": "^14.2.6",
    "typescript": "~6.0.3",
    "workbox-cli": "^7.4.1"
  },
  "scripts": {
    "start": "expo start --web",
    "web": "expo start --web",
    "build:web": "expo export --platform web && cp dist/index.html dist/404.html && workbox generateSW workbox-config.js",
    "predeploy": "npm run build:web",
    "deploy": "gh-pages --nojekyll -d dist",
    "preview:pwa": "serve dist",
    "android": "expo start --android",
    "ios": "expo start --ios"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
