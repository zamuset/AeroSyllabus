{
  "expo": {
    "name": "AeroSyllabus",
    "slug": "AeroSyllabus",
    "scheme": "aerosyllabus",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0B1C2C",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aerosyllabus.app"
    },
    "android": {
      "package": "com.aerosyllabus.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1C2C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "lang": "es",
      "name": "AeroSyllabus",
      "themeColor": "#0B1C2C",
      "backgroundColor": "#0B1C2C"
    },
    "experiments": {
      "baseUrl": "/AeroSyllabus"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset",
      "expo-status-bar"
    ]
  }
}
